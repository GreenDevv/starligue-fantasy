# ARCHITECTURE.md §10
DATABASE_URL=postgresql://user:password@localhost:5432/starligue_fantasy
AUTH_SECRET=
AUTH_GOOGLE_ID=            # optionnel
AUTH_GOOGLE_SECRET=
API_SPORTS_KEY=            # v1.handball.api-sports.io
API_SPORTS_LEAGUE_ID=27    # ID StarLigue dans API-Sports (à confirmer via GET /leagues)
LNH_API_BASE_URL=          # URL API interne lnh.fr si découverte (optionnel)
CRON_SECRET=               # protège /api/cron/*
INITIAL_BUDGET=140.0
NEXT_PUBLIC_APP_URL=http://localhost:3000
COMING_SOON=              # "true" affiche la page teaser à la place de la home
INSTAGRAM_ACCESS_TOKEN=    # token longue durée du compte @starliguefantasy (Meta for Developers)
INSTAGRAM_BUSINESS_ACCOUNT_ID=  # Instagram Business Account ID (via Graph API /me/accounts puis /{page-id}?fields=instagram_business_account)
RESEND_API_KEY=            # clé API resend.com — envoi de l'email de réinitialisation de mot de passe
EMAIL_FROM=contact@starliguefantasy.fr  # domaine vérifié côté Resend (SPF/DKIM)
NEXT_PUBLIC_CARTO_API_KEY= # tuiles de fond de carte (widget "D'où viennent les managers") — gratuite, sans compte, sans CB, à demander sur carto.com/basemaps/apikey ; exposée au client (NEXT_PUBLIC_) car la carte Leaflet est construite dans le navigateur
